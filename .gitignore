# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Local data / generated artifacts
*.duckdb
*.duckdb.wal
out/
ground_truth.json

# Ignore everything under data/, but keep the committed, versioned libraries
# (the CC BY 4.0 benchmark library and the FX rates file ship with the repo).
/data/*
!/data/benchmarks/
!/data/fx/
# Public ad-volume snapshots are maintainer-built, versioned and bundled to users
# (empty placeholders until fetched/coded). The *_review.csv dumps carry raw
# creative text from the API pull and stay local.
!/data/snapshots/
/data/snapshots/*_review.csv

# Secrets — credentials must only ever come from environment variables
.env
*.env

